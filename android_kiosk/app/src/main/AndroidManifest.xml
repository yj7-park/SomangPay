<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.somangpay.kiosk">

    <!-- NFC 하드웨어 권한 및 인터넷 권한 -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 인앱 자동/수동 업데이트: 스토어를 거치지 않는 사이드로드 APK를 갱신 설치하려면
         API 26+에서 명시적으로 이 권한이 있어야 시스템 설치 화면을 띄울 수 있다 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 입금 문자 자동감지(관리자 앱 전용, BuildConfig.SMS_DETECT_ENABLED로 런타임에 게이팅) -
         은행 알림 문자를 가로채 window.onSmsReceived로 넘기기 위해 필요. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- 가로 고정은 매니페스트가 아니라 MainActivity.onCreate()에서
                 BuildConfig.KIOSK_LOCKDOWN_ENABLED일 때만 프로그램적으로 적용한다
                 (admin/user 플레이버는 기기 방향을 자유롭게 따라가야 하므로). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 입금 문자 자동감지(SmsReceiver, 관리자 앱 전용 - BuildConfig.SMS_DETECT_ENABLED로
             onReceive 시작부에서 게이팅). 동적 등록(onResume/onPause) 대신 정적으로 매니페스트에
             등록해서, 앱이 백그라운드에 있거나 프로세스가 완전히 종료된 상태에서도 시스템이
             깨워서 전달하게 한다 - SMS_RECEIVED는 안드로이드 8+ 백그라운드 브로드캐스트 제한의
             예외 대상이라 가능하다.
             android:permission="BROADCAST_SMS"를 걸어뒀었는데 실기기(삼성)에서 진짜 외부 문자가
             와도 onReceive 자체가 전혀 호출되지 않는 게 확인되어 제거한다 - SMS_RECEIVED는
             안드로이드 코어 protected-broadcast 목록에 있어 어차피 제3자 앱이 가짜로 보낼 수
             없으므로, 리시버 쪽에서 추가로 권한을 요구하지 않아도 위장 방지 효과는 동일하다.
             priority를 높여 다른(예: 삼성 자체 스팸 필터) 리시버가 먼저 abortBroadcast()로
             가로채 가는 경우도 배제한다. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 다운로드한 업데이트 APK 파일을 file:// 대신 content:// URI로 시스템 설치
             화면(PackageInstaller)에 안전하게 넘기기 위한 FileProvider - 세 플레이버가
             applicationId만 다르므로 authorities도 매니페스트 플레이스홀더로 함께 갈린다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
