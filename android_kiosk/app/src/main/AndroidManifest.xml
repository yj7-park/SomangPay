<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.somangpay.kiosk">

    <!-- NFC 하드웨어 권한 및 인터넷 권한 -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 인앱 자동/수동 업데이트: 스토어를 거치지 않는 사이드로드 APK를 갱신 설치하려면
         API 26+에서 명시적으로 이 권한이 있어야 시스템 설치 화면을 띄울 수 있다 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 입금 문자 자동감지(관리자 앱 전용, BuildConfig.SMS_DETECT_ENABLED로 런타임에 게이팅) -
         은행 알림 문자를 가로채 window.onSmsReceived로 넘기기 위해 필요. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- AdminAlertService(관리자 앱 전용) - 서버 알림을 네이티브 알림으로 띄우는 데 필요.
         POST_NOTIFICATIONS는 안드로이드 13+, FOREGROUND_SERVICE*는 14+(API 34)부터 포그라운드
         서비스 시작/타입 선언에 각각 필요하다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- 가로 고정은 매니페스트가 아니라 MainActivity.onCreate()에서
                 BuildConfig.KIOSK_LOCKDOWN_ENABLED일 때만 프로그램적으로 적용한다
                 (admin/user 플레이버는 기기 방향을 자유롭게 따라가야 하므로). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 입금 문자 자동감지(SmsReceiver, 관리자 앱 전용 - BuildConfig.SMS_DETECT_ENABLED로
             onReceive 시작부에서 게이팅). 동적 등록(onResume/onPause) 대신 정적으로 매니페스트에
             등록해서, 앱이 백그라운드에 있거나 프로세스가 완전히 종료된 상태에서도 시스템이
             깨워서 전달하게 한다 - SMS_RECEIVED는 안드로이드 8+ 백그라운드 브로드캐스트 제한의
             예외 대상이라 가능하다.
             android:permission="BROADCAST_SMS"를 걸어뒀었는데 실기기(삼성)에서 진짜 외부 문자가
             와도 onReceive 자체가 전혀 호출되지 않는 게 확인되어 제거한다 - SMS_RECEIVED는
             안드로이드 코어 protected-broadcast 목록에 있어 어차피 제3자 앱이 가짜로 보낼 수
             없으므로, 리시버 쪽에서 추가로 권한을 요구하지 않아도 위장 방지 효과는 동일하다.
             priority를 높여 다른(예: 삼성 자체 스팸 필터) 리시버가 먼저 abortBroadcast()로
             가로채 가는 경우도 배제한다. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 입금 알림 자동감지의 두 번째 경로(BankNotificationListener, 관리자 앱 전용 -
             BuildConfig.SMS_DETECT_ENABLED로 onNotificationPosted 시작부에서 게이팅).
             RCS/은행 앱 자체 푸시는 SMS_RECEIVED 브로드캐스트가 발생하지 않아 SmsReceiver로는
             못 잡으므로, 발신 경로와 무관하게 기기에 뜨는 모든 알림을 볼 수 있는
             NotificationListenerService로 그 빈틈을 메운다. RECEIVE_SMS와 달리 이 권한은
             requestPermissions()로 팝업을 띄울 수 없고, 사용자가 설정 > 알림 접근 화면에서
             직접 켜야 한다 - MainActivity.openNotificationAccessSettings()가 그 화면을 연다. -->
        <service
            android:name=".BankNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 관리자 앱 전용(BuildConfig.SMS_DETECT_ENABLED로 시작 여부 게이팅) - WebView가
             Web Push를 지원하지 않아(admin.html 상단 주석) 서버가 보내는 관리자 알림을 받을
             방법이 없는 것을 우회한다. /ws/admin에 포그라운드 서비스로 계속 붙어 있다가
             "alert" 메시지가 오면 네이티브 알림으로 띄운다 - MainActivity가 시작한다. -->
        <service
            android:name=".AdminAlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 다운로드한 업데이트 APK 파일을 file:// 대신 content:// URI로 시스템 설치
             화면(PackageInstaller)에 안전하게 넘기기 위한 FileProvider - 세 플레이버가
             applicationId만 다르므로 authorities도 매니페스트 플레이스홀더로 함께 갈린다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
